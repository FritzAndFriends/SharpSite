@inject PluginManager PluginManager
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<div class="card plugin-card @(AdditionalCssClass)">
	<div class="card-header d-flex justify-content-between align-items-baseline gap-1">
		<h4 class="card-title mb-0">@Plugin.DisplayName</h4>
		<span>&mdash;</span>
		<small>@Plugin.Version</small>
	</div>
	<img src="@(string.IsNullOrEmpty(Plugin.Icon) ? DefaultPluginIcon : Plugin.Icon)"
		onerror="this.onerror=null;this.src='@DefaultPluginIcon';"
		alt="@Localizer[SharedResource.sharpsite_plugin_icon]" class="card-img-top" />
	<div class="card-body">
		<p class="card-text">@Plugin.Description</p>
	</div>
	<div class="card-footer d-flex justify-content-between">
		<button type="button" class="btn btn-info">@Localizer[SharedResource.sharpsite_update]</button>
		<button type="button" class="btn btn-danger"
			@onclick="RemovePluginAsync">@Localizer[SharedResource.sharpsite_remove]</button>
	</div>
</div>

@code {
	private const string DefaultPluginIcon = "/img/plugin-icon.svg";

	[Parameter, EditorRequired] public required PluginManifest Plugin { get; set; }
	[Parameter] public string? AdditionalCssClass { get; set; }

	private async Task RemovePluginAsync()
	{
		await PluginManager.RemovePlugin(Plugin.Id);
		NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
	}
}
