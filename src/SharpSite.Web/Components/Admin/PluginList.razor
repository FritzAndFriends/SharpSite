@page "/admin/plugins"
@attribute [Authorize(Roles = Constants.Roles.Admin)]
@inject ApplicationState AppState
@rendermode InteractiveServer

<PageTitle>@Localizer[SharedResource.sharpsite_installedplugins]</PageTitle>

<h3>
	@Localizer[SharedResource.sharpsite_installedplugins]</h3>

@* Add a button that links to the add plugin page With the text add new plugin  *@
<div class="my-4">
	<a href="/admin/addplugin" class="btn btn-primary">@Localizer[SharedResource.sharpsite_addnewplugin]</a>
</div>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
	<div class="alert alert-danger text-center">
		@ErrorMessage
	</div>
}

@if (Plugins.Count == 0)
{
	<p>
		@Localizer[SharedResource.sharpsite_nopluginsinstalled]</p>
}
else
{
	<div class="d-flex flex-wrap gap-3">
		@foreach (var plugin in Plugins)
		{
			var isFileStorage = FileStoragePlugins.Any(fs => fs.Id == plugin.Value.Id && fs.Version == plugin.Value.Version);
			<PluginCard Plugin="plugin.Value"
						AdditionalCssClass="@( !string.IsNullOrEmpty(ErrorMessage) && isFileStorage ? "border border-danger" : null )"
						OnPluginRemoved="OnPluginRemoved" />
		}
	</div>
}

@code {
	private Dictionary<string, PluginManifest> Plugins = new();
	private List<PluginManifest> FileStoragePlugins = [];
	private string ErrorMessage = string.Empty;

	protected override void OnInitialized()
	{
		Plugins = new Dictionary<string, PluginManifest>(AppState.Plugins);
		UpdateFileStoragePlugins();
	}

	private void UpdateFileStoragePlugins()
	{
		FileStoragePlugins = Plugins.Values
			.Where(p => p.Features is not null && p.Features.Any(f => f == PluginFeatures.FileStorage))
			.ToList();

		if (FileStoragePlugins.Count > 1)
		{
			ErrorMessage = SharedResource.sharpsite_plugin_filestorage_error_multiple;
		}
		else if (FileStoragePlugins.Count == 0)
		{
			ErrorMessage = SharedResource.sharpsite_plugin_filestorage_error_none;
		}
		else
		{
			ErrorMessage = string.Empty;
		}
	}

	private async Task OnPluginRemoved(string pluginId)
	{
		if (Plugins.Remove(pluginId))
		{
			UpdateFileStoragePlugins();
			await InvokeAsync(StateHasChanged);
		}
	}
}
